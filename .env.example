# =====================================================================
# Vagas App — exemplo de configuração
#
# 1. Copie para .env:
#      cp .env.example .env
#
# 2. Gere os valores e edite o .env:
#      openssl rand -hex 32      # rode 2x: uma vez para cada chave abaixo
#
# 3. Suba o app (veja o README: `docker compose up -d --build`).
#
# NUNCA commite o .env com valores reais — só este .env.example vai para o
# repositório (o .gitignore bloqueia o .env).
# =====================================================================

# Senha de acesso ao painel (http://localhost:8234).
# Qualquer valor serve; quanto mais forte, melhor.
VAGAS_PASSWORD=troque-por-uma-senha-forte

# Segredo que assina as sessões de login.
# Gere com: openssl rand -hex 32
VAGAS_SECRET_KEY=troque-por-um-segredo-longo

# Chave usada por produtores e ranqueadores (muse.ai, scripts...) no header
# X-API-Key. Sem ela, os endpoints de produção rejeitam chamadas.
# Gere com: openssl rand -hex 32
VAGAS_API_KEY=troque-por-uma-chave-de-api

# ---------------------------------------------------------------------
# Opcional — onde fica o vagas.db (SQLite).
# No Docker já vem configurado como /data (não precisa mexer).
# Rode fora do Docker com: VAGAS_DATA_DIR=./data uvicorn app.main:app
# ---------------------------------------------------------------------
# VAGAS_DATA_DIR=/data